POSTGRES_DB=m1917
POSTGRES_USER=m1917
POSTGRES_PASSWORD=change-me

M1917_ENVIRONMENT=development
M1917_DATABASE_URL=postgresql+asyncpg://m1917:change-me@localhost:5432/m1917
M1917_REDIS_URL=redis://localhost:6379/0
M1917_JWT_SECRET=replace-with-at-least-32-random-characters
M1917_OTP_PEPPER=replace-with-an-independent-random-secret
# Development only. Generate a unique Fernet key for every production environment.
M1917_PII_ENCRYPTION_KEY=0HzTSHdTqMQboIFWW1d8PuI2OhVrPYJBZ9ZCrVnz1kk=
M1917_OTP_PROVIDER=console
# Comma-separated Flutter Web origins, or a JSON list.
M1917_CORS_ORIGINS=http://localhost:8080
# Production SMS adapter:
# M1917_SMS_GATEWAY_URL=https://sms-provider.example/v1/messages
# M1917_SMS_API_TOKEN=replace-with-provider-token
# M1917_SMS_SENDER_NAME=ALASH

# Development bootstrap only. Existing users' roles are never changed by this command.
M1917_BOOTSTRAP_USERS_JSON=[{"phone":"+77000000001","role":"BOSS","full_name":"Development Boss","employee_id":"BOSS-001","city":"Lipetsk"},{"phone":"+77000000002","role":"ADMIN","full_name":"Development Admin","employee_id":"ADMIN-001","city":"Lipetsk"},{"phone":"+77000000003","role":"MASTER","full_name":"Development Master","employee_id":"MASTER-001","city":"Lipetsk"},{"phone":"+77000000004","role":"WORKER","full_name":"Development Worker","employee_id":"WORKER-001","city":"Lipetsk"}]
