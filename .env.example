POSTGRES_DB=m1917
POSTGRES_USER=m1917
POSTGRES_PASSWORD=change-me

M1917_ENVIRONMENT=development
M1917_DATABASE_URL=postgresql+asyncpg://m1917:change-me@localhost:5432/m1917
M1917_REDIS_URL=redis://localhost:6379/0
M1917_JWT_SECRET=replace-with-at-least-32-random-characters
M1917_OTP_PEPPER=replace-with-an-independent-random-secret
# Development only. Generate a unique Fernet key for every production environment.
M1917_PII_ENCRYPTION_KEY=0HzTSHdTqMQboIFWW1d8PuI2OhVrPYJBZ9ZCrVnz1kk=
M1917_LOGIN_PHONE_HOUR_LIMIT=10
M1917_LOGIN_IP_HOUR_LIMIT=100
# Disabled until Firebase is configured. Keep credentials outside the repository.
M1917_PUSH_ENABLED=false
M1917_FIREBASE_PROJECT_ID=
M1917_FIREBASE_SECRETS_DIR=./.secrets/firebase
M1917_PUSH_WEB_URL=
# Flutter Web port; change this and CORS origins together if 8080 is occupied.
M1917_MOBILE_PORT=8080
# Flutter Web origins as a JSON list.
M1917_CORS_ORIGINS='["http://localhost:8080"]'
# Development bootstrap only. Existing users' roles are never changed by this command.
M1917_BOOTSTRAP_USERS_JSON=[{"phone":"+77000000001","password":"Change-this-password-123","role":"BOSS","full_name":"Руководитель","employee_id":"BOSS-001","city":"Липецк"},{"phone":"+77000000002","password":"Change-this-password-123","role":"ADMIN","full_name":"Администратор","employee_id":"ADMIN-001","city":"Липецк"},{"phone":"+77000000003","password":"Change-this-password-123","role":"MASTER","full_name":"Мастер","employee_id":"MASTER-001","city":"Липецк"},{"phone":"+77000000004","password":"Change-this-password-123","role":"WORKER","full_name":"Сотрудник","employee_id":"WORKER-001","city":"Липецк"}]
